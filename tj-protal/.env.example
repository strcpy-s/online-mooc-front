# 复制为 .env 后填入你自己的地址（.env 已被 .gitignore 忽略，不会入库）
# 各环境后端地址，按 package.json scripts 的 --mode 取值：
#   npm run dev → development，dev:test → test，dev:pro / pro → product
VITE_API_HOST_DEVELOPMENT=
VITE_API_HOST_TEST=
VITE_API_HOST_PRODUCT=
# mock 模式（npm start）的接口基地址
VITE_MOCK_HOST=
# Vite 开发服务器图片反向代理目标（留空则不下发对应代理规则）
VITE_IMG_TX_TARGET=
VITE_IMG_MINIO_TARGET=
