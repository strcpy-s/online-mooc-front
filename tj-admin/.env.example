# 复制为 .env 后填入你自己的地址（.env 已被 .gitignore 忽略，不会入库）
# 各环境后端地址，按 package.json scripts 的 --mode 取值：
#   npm run dev → development，dev:test → test，dev:prod → product，build:prod → pro
VITE_API_HOST_DEVELOPMENT=
VITE_API_HOST_TEST=
VITE_API_HOST_PRODUCT=
VITE_API_HOST_PRO=
# mock 模式（npm start）的接口基地址
VITE_MOCK_HOST=
# mock 模式下刷新 token 的地址
VITE_REFRESH_MOCK_HOST=
# Vite 开发服务器图片反向代理目标（留空则不下发 /img-tx 代理规则）
VITE_IMG_TX_TARGET=
